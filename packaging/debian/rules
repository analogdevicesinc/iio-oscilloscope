#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_OPTIONS = nocheck

# Default values in case variables are not passed by build script
PACKAGE ?= iio-oscilloscope
APPIMAGE_ARCH ?= aarch64
IIO_OSC_APPIMAGE ?= iio-oscilloscope-$(APPIMAGE_ARCH).AppImage

%:
	dh $@ --no-auto

override_dh_auto_configure:
	@echo "=== iio-oscilloscope Debian packaging ==="
	@echo "PACKAGE          = $(PACKAGE)"
	@echo "APPIMAGE_ARCH    = $(APPIMAGE_ARCH)"
	@echo "IIO_OSC_APPIMAGE = $(IIO_OSC_APPIMAGE)"
	@echo "========================================"

override_dh_auto_build:
	@echo "Looking for AppImage at: ../$(IIO_OSC_APPIMAGE)"
	cp ../$(IIO_OSC_APPIMAGE) $(IIO_OSC_APPIMAGE) || \
		(echo "ERROR: AppImage not found! Expected ../$(IIO_OSC_APPIMAGE)" && exit 1)
	chmod +x $(IIO_OSC_APPIMAGE)

override_dh_auto_install:
	# Install the AppImage
	install -D -m 0755 $(IIO_OSC_APPIMAGE) \
		debian/$(PACKAGE)/usr/bin/$(IIO_OSC_APPIMAGE)

	# Install resources
	install -d debian/$(PACKAGE)/usr/lib/osc

	cp -r waveforms      debian/$(PACKAGE)/usr/lib/osc/ 2>/dev/null || true
	cp -r profiles       debian/$(PACKAGE)/usr/lib/osc/ 2>/dev/null || true
	cp -r filters        debian/$(PACKAGE)/usr/lib/osc/ 2>/dev/null || true
	cp -r xmls           debian/$(PACKAGE)/usr/lib/osc/ 2>/dev/null || true
	cp -r block_diagrams debian/$(PACKAGE)/usr/lib/osc/ 2>/dev/null || true

	# Extra files if present
	cp -f styles.css debian/$(PACKAGE)/usr/lib/osc/ 2>/dev/null || true

	# Install wrapper
	install -D -m 0755 debian/osc-wrapper debian/$(PACKAGE)/usr/bin/osc-wrapper

	# Create convenient symlinks
	ln -sf osc-wrapper debian/$(PACKAGE)/usr/bin/osc
	ln -sf osc-wrapper debian/$(PACKAGE)/usr/bin/iio-oscilloscope

	# Desktop file, polkit, icon, etc.
	install -D -m 0644 debian/iio-oscilloscope.desktop \
		debian/$(PACKAGE)/usr/share/applications/iio-oscilloscope.desktop

	install -D -m 0644 debian/org.adi.pkexec.iio-oscilloscope.AppImage.policy \
		debian/$(PACKAGE)/usr/share/polkit-1/actions/org.adi.pkexec.iio-oscilloscope.AppImage.policy

	install -D -m 0644 icons/osc128.png \
		debian/$(PACKAGE)/usr/share/osc/osc128.png 2>/dev/null || true

	install -D -m 0644 debian/copyright \
		debian/$(PACKAGE)/usr/share/doc/$(PACKAGE)/copyright

override_dh_auto_test:
	:

override_dh_shlibdeps:
	:

override_dh_strip:
	:
